# このファイルを同じフォルダに secrets.toml という名前でコピーし、値を書き換える。
# secrets.toml は .gitignore 済み（git に入らない）。手順は supabase/README.md。
[supabase]
# Supabase 管理画面 → Project Settings → API（Data API）の Project URL
url = "https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
# 同じ画面の anon / public キー（publishable key）。service_role / secret キーは絶対に書かないこと
anon_key = "eyJhbGciOi..."
